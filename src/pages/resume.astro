---
import { Font } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import resumePdf from '../assets/valentin-radulescu-resume.pdf';
import avatar from '../assets/valentin-radulescu.jpg';
import data from '../data/resume.json';
import { marked } from 'marked';
import '@fortawesome/fontawesome-free/css/all.css';
import '../styles/resume.css';

const urlWithoutProtocol = (url: string) => new URL(url).host;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.basics.name,
  url: data.basics.url,
  image: new URL(avatar.src, Astro.site),
  jobTitle: data.basics.label,
  address: {
    '@type': 'PostalAddress',
    addressLocality: data.basics.location.city,
    addressCountry: data.basics.location.countryCode,
  },
  sameAs: data.basics.profiles.map(profile => profile.url),
  knowsAbout: data.skills.flatMap(skill => skill.keywords),
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: data.education[0].institution,
    url: data.education[0].url,
  },
};
---

<!doctype html>
<html lang="en">
	<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href="https://valentin.io/resume/" />
    <title>Valentin Radulescu | Front-End Engineer Resume</title>
    <meta name="description" content="Resume of Valentin Radulescu, a front-end engineer specializing in React, React Native, TypeScript and JavaScript. Based in Bucharest, open to remote work and relocation." />
    <Font cssVariable="--font-atkinson" preload />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      /* Set theme preference as dataset attribute before rendering markup. */
      try {
        const currentTheme = localStorage.getItem('resume-theme') || 'dark';
        if (currentTheme === 'light' || currentTheme === 'dark') {
          document.documentElement.dataset.theme = currentTheme;
        } else {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
	</head>
	<body>
    <main>
      <a class="back-link screen-only" href="/">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to home
      </a>
      <button class="theme-toggle screen-only" type="button" data-theme-toggle aria-pressed="false">
        <span class="theme-toggle__light"><i class="fa-solid fa-sun"></i></span>
        <span class="theme-toggle__dark"><i class="fa-solid fa-moon"></i></span>
      </button>
      <header>
        <h1>
          <div>
            <div class="name">{data.basics.name}</div>
            <div class="role">{data.basics.label}</div>
          </div>
          <img class="avatar screen-only" src={avatar.src} alt={data.basics.name}/>
        </h1>
        <ul class="social" aria-label="resume links">
          {data.basics.profiles.map(p =>
            <li class="screen-only">
              <a href={p.url} title={p.network}>
                <i class={p.icon} aria-hidden="true"></i> {p.username}
              </a>
            </li>
          )}
          <li>
            <a href={data.basics.url} title="personal site">
              <i class="fa-solid fa-house" aria-hidden="true"></i>{" "}
              {urlWithoutProtocol(data.basics.url)}
            </a>
          </li>
          <li>
            <a href={data.basics.location.url}>
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>{" "}
              {data.basics.location.city}, {data.basics.location.countryCode}
            </a>
          </li>
          <li>
            <a id="contact-email" href="" data-base64={btoa(data.basics.email)} data-type="email" aria-label="Email">
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            </a>
          </li>
          <li class="print-only">
            <a href="" data-base64={btoa(data.basics.phone)} data-type="phone" aria-label="Phone">
              <i class="fa-solid fa-phone" aria-hidden="true"></i>
            </a>
          </li>
          <li class="screen-only">
            <a href={resumePdf}>
              <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> PDF version
            </a>
          </li>
        </ul>
        <p>{data.basics.summary}</p>
        <div class="skills">
          {data.skills.map(s =>
            <p>
              {s.name} skills:{" "}
              {s.keywords.map(k => <span class="badge">{k}</span>)}
            </p>
          )}
        </div>
      </header>
      <section>
        <h2>Work Experience</h2>
        {data.work.map(job =>
          <article class="subsection">
            <h3>{job.position} at <a href={job.url}>{job.name}</a></h3>
            <p class="subsection-dates">
              <FormattedDate date={new Date(job.startDate)} showDay={false} />
              &nbsp;&mdash;&nbsp;
              <FormattedDate date={new Date(job.endDate)} showDay={false} />
              </p>
            <p class="subsection-summary">{job.summary}</p>
            <ul class="subsection-highlights">
              {job.highlights.map(h => <li>{h}</li>)}
            </ul>
          </article>
        )}
      </section>
      <section>
        <h2>Education</h2>
        {data.education.map(edu =>
          <article class="subsection">
            <h3>{edu.studyType} {edu.area} at <a href={edu.url}>{edu.institution}</a></h3>
            <p class="subsection-dates">
              <FormattedDate date={new Date(edu.startDate)} showDay={false} />
              &nbsp;&mdash;&nbsp;
              <FormattedDate date={new Date(edu.endDate)} showDay={false} />
              </p>
            <ul class="subsection-highlights">
              {edu.courses.map(h => <li>{h}</li>)}
            </ul>
          </article>
        )}
      </section>
      <section>
        <h2>Projects</h2>
        {data.projects.map(pro =>
          <article class="subsection">
            <h3>{pro.name} <a href={pro.url} class="screen-only" aria-label={`Open ${pro.name} project link`}><i class="fa-solid fa-link" aria-hidden="true"></i></a></h3>
            <p class="subsection-links print-only">
              <a href={pro.url}>{pro.url}</a>
            </p>
            <p class="subsection-summary">{pro.description}</p>
            <ul class="subsection-highlights">
              {pro.highlights.map(h => <li set:html={marked.parseInline(h)} />)}
            </ul>
          </article>
        )}
      </section>
      <section>
        <h2>Languages</h2>
        <div class="subsection-cards">
          {data.languages.map(lang =>
            <div>
              <strong>{lang.language}</strong>
              <span>{lang.fluency}</span>
            </div>
          )}
        </div>
      </section>
    </main>
    <script>
      /* Initialize theme toggle with user preference. Update theme on click. */
      const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

      if (themeToggle) {
        const updateThemeToggle = () => {
          const theme = document.documentElement.dataset.theme;
          const nextTheme = theme === 'dark' ? 'light' : 'dark';
          themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
          themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
        };
        updateThemeToggle();

        themeToggle.addEventListener('click', () => {
          const theme = document.documentElement.dataset.theme;
          const nextTheme = theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = nextTheme;
          updateThemeToggle();

          try {
            localStorage.setItem('resume-theme', nextTheme);
          } catch {
            // Keep the selected theme for the current page when storage is unavailable.
          }
        });
      }

      /* Sensitive contact info is encoded in the raw HTML. Decode it after page loads. */
      document.addEventListener('DOMContentLoaded', function() {
        const elements = document.querySelectorAll('a[data-base64]') as NodeListOf<HTMLAnchorElement>;

        for (const el of elements) {
          const elementType = el.dataset.type ?? "";
          const encodedData = el.dataset.base64 ?? "";
          const decodedData = atob(encodedData);

          switch (elementType) {
            case "email": el.href = `mailto:${decodedData}`; break;
            case "phone": el.href = `tel:${decodedData}`; break;
          }

          el.append(document.createTextNode(` ${decodedData}`));
        }
      });

      /* Force page to switch to light theme for printing. */
      let themeBeforePrint: string | undefined;

      window.addEventListener('beforeprint', () => {
        themeBeforePrint = document.documentElement.dataset.theme;
        document.documentElement.dataset.theme = 'light';
      });

      window.addEventListener('afterprint', () => {
        if (themeBeforePrint) {
          document.documentElement.dataset.theme = themeBeforePrint;
        }
      });
    </script>
	</body>
</html>
