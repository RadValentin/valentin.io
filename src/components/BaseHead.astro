---
// Import global styles here so that they are included on
// all pages through the use of the <BaseHead /> component.
import '@fortawesome/fontawesome-free/css/all.css';
import '../styles/breakpoints.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/valentin-og-placeholder.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	canonicalURL?: string;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
}

const {
	title, description, image = FallbackImage, canonicalURL: canonicalURLProp,
	type = 'website', pubDate, updatedDate,
} = Astro.props;
const canonicalURL = canonicalURLProp ?? new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image.src, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content={image.width.toString()} />
<meta property="og:image:height" content={image.height.toString()} />
<meta property="og:image:alt" content={title} />
{type === 'article' && (
	<>
		<meta property="article:author" content={Astro.site} />
		{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
	</>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-W429060K20"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-W429060K20');
</script>

<!-- Site scripts -->
<script is:inline>
	(() => {
		const root = document.documentElement;

		try {
			const visitKey = `visited:${window.location.pathname}`;
			if (window.sessionStorage.getItem(visitKey)) {
				root.classList.add('page-visited');
			}
			window.sessionStorage.setItem(visitKey, '1');
		} catch {
			// Keep the normal reveal when sessionStorage is unavailable.
		}

		const allowAnimations = () => {
			if (!root.classList.contains('page-visited')) {
				// Show static content if motion preferences haven't loaded in time.
				root.classList.add(root.dataset.motion === 'on' ? 'can-animate' : 'page-visited');
			}
		};

		// Reveal on load or after two seconds, even if the other scripts fail.
		setTimeout(allowAnimations, 2000);
		window.addEventListener('load', allowAnimations, { once: true });
		window.addEventListener('pageshow', (event) => {
			if (event.persisted) {
				root.classList.add('page-visited');
				root.classList.remove('can-animate');
			}
		});

		// Opt into hiding before the body renders, after the fallback is installed.
		root.classList.add('js');
	})();
</script>
<script>
	import { readMotionState } from '../scripts/utils';

	// Flag for determining if animations are enabled
	let shouldEnableMotion = readMotionState();
	document.documentElement.dataset.motion = shouldEnableMotion ? 'on' : 'off';

	// Disable view transitions when animations are disabled
	if (!shouldEnableMotion) {
		let preferenceElement = document.createElement('style');
		preferenceElement.id = 'motion-preference';
		preferenceElement.textContent = '@view-transition { navigation: none; }';
		document.head.appendChild(preferenceElement);
	}
</script>
