---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import FallbackImage from '../assets/valentin-og-placeholder.jpg';
import { SITE_AUTHOR } from '../consts';
import '../styles/blog-post.css';

type Props = CollectionEntry<'blog'>['data'] & {
	canonicalURL?: string;
	headings?: MarkdownHeading[];
	readingMinutes?: number;
};

const {
	title, description, pubDate, updatedDate, canonicalURL, heroImage,
	headings = [], readingMinutes,
} = Astro.props;
const sections = headings.filter(({ depth }) => depth === 2 || depth === 3);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url: canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href,
	image: new URL((heroImage ?? FallbackImage).src, Astro.site).href,
	datePublished: pubDate.toISOString(),
	dateModified: updatedDate?.toISOString(),
	author: {
		'@type': 'Person',
		name: SITE_AUTHOR,
		url: Astro.site?.href,
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonicalURL={canonicalURL}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
	</head>
	<body class="article-page" id="top">
		<a class="article-skip-link" href="#main">Skip to article</a>
		<div class="shell">
			<Header />
			<main class="page article-main" id="main">
				<nav class="article-path" aria-label="Article navigation">
					<a href="/blog/"><span aria-hidden="true">←</span> All writing</a>
					<span>Notes / {pubDate.getUTCFullYear()}</span>
				</nav>
				<article aria-labelledby="article-title">
					<header class="article-heading brick-frame">
						<p class="brick-legend" aria-hidden="true">Article</p>
						<div class="reveal">
							<div class="article-meta">
								<FormattedDate date={pubDate} />
								{readingMinutes && <span>{readingMinutes} min read</span>}
								{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
							</div>
							<h1 id="article-title">{title}</h1>
							<p class="article-deck">{description}</p>
						</div>
					</header>
					<div class:list={['article-body', { 'article-body--with-aside': sections.length > 0 || !!heroImage }]}>
						{(sections.length > 0 || heroImage) && (
							<aside class="article-aside" aria-label="Article resources">
								<div class="article-aside-inner">
									{sections.length > 0 && (
										<nav class="article-index" aria-labelledby="article-index-label">
											<h2 id="article-index-label">On this page</h2>
											<ol>
												{sections.map(({ depth, slug, text }) => (
													<li class:list={{ 'article-index-subsection': depth === 3 }}>
														<a href={'#' + slug}>{text}</a>
													</li>
												))}
											</ol>
										</nav>
									)}
									{heroImage && (
										<div class="article-cover">
											<Image src={heroImage} width={640} alt="" loading="lazy" />
										</div>
									)}
								</div>
							</aside>
						)}
						<div class="article-prose"><slot /></div>
					</div>
					<nav class="article-end" aria-label="After the article">
						<a href="/blog/"><span aria-hidden="true">←</span> All writing</a>
						<a href="#top">Back to top <span aria-hidden="true">↑</span></a>
					</nav>
				</article>
			</main>
			<Footer />
		</div>
	</body>
</html>
